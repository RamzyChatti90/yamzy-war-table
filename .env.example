# Template — copier en .env (gitignored) pour ton install locale.

# URL de l'instance Yamzy hôte (dev local OU prod déployé)
YAMZY_HOST_URL=http://localhost:4200
YAMZY_API_URL=http://localhost:8080

# Port du frontend extension
EXT_FRONTEND_PORT=4201

# Mode (development | production | standalone)
EXT_MODE=development
